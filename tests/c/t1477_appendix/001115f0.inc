static void c001115f0_run(const c001115f0_case *c)
{
    static uint32_t before[8192];
    unsigned count = 0;
    prepare();
    for (unsigned w = 0; w < c->window_count; ++w)
        for (uint32_t a = c->windows[w].low; a < c->windows[w].high; a += 4u)
            guest_write32(a, c001115f0_canary(a));
    for (unsigned k = 0; k < c->setup_count; ++k)
        guest_write32(c->setup[k].address, c->setup[k].value);
    for (unsigned w = 0; w < c->window_count; ++w)
        for (uint32_t a = c->windows[w].low; a < c->windows[w].high; a += 4u)
            before[count++] = guest_read32(a);
    g_esp = c->esp;
    g_eax = 0x11111111u; g_ecx = 0x22222222u; g_edx = 0x33333333u;
    g_ebx = 0xB1B1B1B1u; g_esi = 0x51515151u; g_edi = 0xD1D1D1D1u; g_ebp = 0xBBBB0001u;
    g_df = c->df;
    uint32_t *const slots[8] = {c001115f0_xmm0, c001115f0_xmm1, c001115f0_xmm2, c001115f0_xmm3, c001115f0_xmm4, c001115f0_xmm5, c001115f0_xmm6, c001115f0_xmm7};
    for (unsigned reg = 0; reg < 8; ++reg)
        for (unsigned lane = 0; lane < 4; ++lane)
            slots[reg][lane] = 0xA0000000u | (reg << 8) | lane;
    invoke(0x001115F0u, 4u);
    CHECK(g_eax == c->eax);
    CHECK(g_ecx == c->ecx);
    CHECK(g_edx == c->edx);
    CHECK(g_ebx == c->ebx);
    CHECK(g_esi == c->esi);
    CHECK(g_edi == c->edi);
    CHECK(g_ebp == c->ebp);
    CHECK(g_esp == c->esp + 4u);
    CHECK(g_df == c->df);
    for (unsigned reg = 0; reg < 8; ++reg) {
        uint32_t expected[4];
        for (unsigned lane = 0; lane < 4; ++lane) expected[lane] = 0xA0000000u | (reg << 8) | lane;
        for (unsigned k = 0; k < c->xmm_count; ++k)
            if (c->xmm[k].reg == reg)
                for (unsigned lane = 0; lane < 4; ++lane) expected[lane] = c->xmm[k].lane[lane];
        for (unsigned lane = 0; lane < 4; ++lane) CHECK(slots[reg][lane] == expected[lane]);
    }
    count = 0;
    for (unsigned w = 0; w < c->window_count; ++w) {
        for (uint32_t a = c->windows[w].low; a < c->windows[w].high; a += 4u) {
            uint32_t expected = before[count++];
            for (unsigned k = 0; k < c->diff_count; ++k)
                if (c->diff[k].address == a) expected = c->diff[k].value;
            CHECK(guest_read32(a) == expected);
        }
    }
}

static void c001115f0_hand(void)
{
    /* hand-derived: record 0x20000, kind 5, constant at 0x475C78 */
    prepare();
    g_esp = 0x6000u;
    guest_write32(0x6000u, 0x00010000u);
    guest_write32(0x6004u, 0x20000u);      /* a0 record */
    guest_write32(0x6008u, 5u);            /* a1 kind */
    guest_write32(0x600Cu, 0x111u);        /* a2 blend */
    guest_write32(0x6010u, 0x222u);        /* a3 flags */
    guest_write32(0x6014u, 0x3F800000u);   /* a4 float */
    guest_write32(0x6018u, 0x333u);        /* a5 texture */
    guest_write32(0x601Cu, 0x444u);        /* a6 */
    guest_write32(0x6020u, 0x40000000u);   /* a7 float */
    guest_write32(0x475C78u, 0x40490FDBu);
    guest_write32(0x20050u, 0xDEADu);
    g_ebx = 1u; g_esi = 2u; g_edi = 0xE0E0E0E0u; g_ebp = 4u; g_df = 0;
    for (unsigned lane = 0; lane < 4; ++lane) c001115f0_xmm0[lane] = 0x77u + lane;
    invoke(0x001115F0u, 4u);
    CHECK(g_eax == 5u && g_ecx == 0x444u && g_edx == 0x20000u && g_edi == 0xE0E0E0E0u);
    CHECK(g_ebx == 1u && g_esi == 2u && g_ebp == 4u);
    CHECK(guest_read32(0x20000u) == 0x222u);
    CHECK(guest_read32(0x20004u) == 0x3F800000u);
    CHECK(guest_read32(0x2000Cu) == 5u);
    CHECK(guest_read32(0x20010u) == 0x333u);
    CHECK(guest_read32(0x20014u) == 0x111u);
    CHECK(guest_read32(0x20018u) == 0x444u);
    CHECK(guest_read32(0x2001Cu) == 0x40000000u);
    CHECK(guest_read32(0x200A0u) == 0x40490FDBu);
    CHECK(guest_read32(0x20050u) == 0u);   /* zero fill */
    CHECK(guest_read32(0x73BD68u) == 0x20000u);
    CHECK(c001115f0_xmm0[0] == 0x40490FDBu && c001115f0_xmm0[1] == 0u);
    CHECK(c001115f0_xmm0[2] == 0u && c001115f0_xmm0[3] == 0u);
}

static void test_t1477_appendix_001115f0(void)
{
    for (unsigned i = 0; i < sizeof c001115f0_cases / sizeof c001115f0_cases[0]; ++i) c001115f0_run(&c001115f0_cases[i]);
    c001115f0_hand();
}
