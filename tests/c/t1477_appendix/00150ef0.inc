static void c00150ef0_run(const c00150ef0_case *c)
{
    prepare();
    g_esp = c->esp;
    guest_write32(g_esp, 0x12345678u);
    for (unsigned i = 0; i < c->nsetup; i++) {
        const c00150ef0_blob *b = &c->setup[i];
        if (b->bytes) {
            memcpy(&memory[b->address], b->bytes, b->length);
        } else {
            memset(&memory[b->address], b->fill, b->length);
        }
    }
    g_ebx = c->ebx;
    g_esi = c->esi;
    g_edi = c->edi;
    g_ebp = c->ebp;
    g_df = 0;
    memcpy(c00150ef0_before, memory, sizeof memory);
    invoke(0x00150EF0u, 4u);
    if (g_eax != c->eax_out || g_ecx != c->ecx_out || g_edx != c->edx_out) {
        fprintf(stderr, "case %s: eax %08X ecx %08X edx %08X\n", c->name, g_eax, g_ecx, g_edx);
    }
    CHECK(g_eax == c->eax_out);
    CHECK(g_ecx == c->ecx_out);
    CHECK(g_edx == c->edx_out);
    CHECK(g_ebx == c->ebx_out);
    CHECK(g_esi == c->esi_out);
    CHECK(g_edi == c->edi_out);
    CHECK(g_ebp == c->ebp_out);
    CHECK(g_esp == c->esp + 4u);
    for (unsigned i = 0; i < c->ndiff; i++) {
        memcpy(&c00150ef0_before[c->diff[i].address], c->diff[i].bytes, c->diff[i].length);
    }
    if (memcmp(c00150ef0_before, memory, sizeof memory) != 0) {
        fprintf(stderr, "case %s: memory differs\n", c->name);
    }
    CHECK(memcmp(c00150ef0_before, memory, sizeof memory) == 0);
}


static void test_t1477_appendix_00150ef0(void)
{
    for (unsigned i = 0; i < sizeof c00150ef0_cases / sizeof c00150ef0_cases[0]; i++) {
        c00150ef0_run(&c00150ef0_cases[i]);
    }
}
