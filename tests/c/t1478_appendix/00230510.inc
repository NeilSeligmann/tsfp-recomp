static uint32_t t1478a_00230510_hash(uint32_t base, uint32_t bytes)
{
    uint32_t hash = 2166136261u;
    for (uint32_t i = 0; i < bytes; i++) hash = (hash ^ guest_read8(base + i)) * 16777619u;
    return hash;
}

static void t1478a_00230510_zero(uint32_t base, uint32_t bytes)
{
    for (uint32_t i = 0; i < bytes; i += 4u) guest_write32(base + i, 0u);
}

static void test_t1478_appendix_00230510(void)
{
    (void)prepare;   /* fixed register and stack state is set per scenario below */
    const unsigned window_count = (unsigned)(sizeof t1478a_00230510_windows / sizeof t1478a_00230510_windows[0]);
    for (unsigned k = 0; k < sizeof t1478a_00230510_scenarios / sizeof t1478a_00230510_scenarios[0]; k++) {
        const t1478a_00230510_scenario *s = &t1478a_00230510_scenarios[k];
        const unsigned failures_before = failures;
        for (unsigned f = 0; f < sizeof t1478a_00230510_fills / sizeof t1478a_00230510_fills[0]; f++)
            for (uint32_t o = 0; o < t1478a_00230510_fills[f].bytes; o += 4u)
                guest_write32(t1478a_00230510_fills[f].base + o,
                              ((t1478a_00230510_fills[f].base + o) * 0x9E3779B1u) ^ t1478a_00230510_fills[f].seed);
        for (unsigned c = 0; c < sizeof t1478a_00230510_base / sizeof t1478a_00230510_base[0]; c++)
            guest_write32(t1478a_00230510_base[c].address, t1478a_00230510_base[c].value);
        for (unsigned c = 0; c < s->setup_count; c++)
            guest_write32(s->setup[c].address, s->setup[c].value);
        g_eax = s->eax; g_ecx = s->ecx; g_edx = s->edx;
        g_ebx = s->ebx; g_esi = s->esi; g_edi = s->edi; g_ebp = s->ebp;
        g_df = (int)s->df;
        g_esp = s->esp;
        guest_write32(g_esp, 0x12345678u);   /* return slot (never read by the adapter) */
        invoke(0x00230510u, 4u);
        CHECK(g_eax == s->out_eax); CHECK(g_ecx == s->out_ecx); CHECK(g_edx == s->out_edx);
        CHECK(g_ebx == s->out_ebx); CHECK(g_esi == s->out_esi);
        CHECK(g_edi == s->out_edi); CHECK(g_ebp == s->out_ebp);
        for (unsigned c = 0; c < s->changed_count; c++)
            CHECK(guest_read32(s->changed[c].address) == s->changed[c].value);
        for (unsigned i = 0; i < window_count; i++)
            CHECK(t1478a_00230510_hash(t1478a_00230510_windows[i].base, t1478a_00230510_windows[i].bytes) == s->checksum[i]);
        CHECK(t1478a_00230510_hash(s->esp - 0x40u, 0x80u) == s->checksum[window_count]);
        if (failures != failures_before) fprintf(stderr, "scenario %s failed\n", s->name);
