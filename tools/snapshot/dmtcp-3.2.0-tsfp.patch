+// T1153: memfd_create had no wrapper, so a memfd (Mesa lavapipe allocation fd) was never a connection and was
+// closed by a restart. Track it as a file connection (its path is "/memfd:<name> (deleted)").
+extern "C" int
+memfd_create(const char *name, unsigned int flags)
+{
+  WrapperLock wrapperLock;
+  static int (*realMemfd)(const char *, unsigned int) = NULL;
+  if (realMemfd == NULL) {
+    realMemfd = (int (*)(const char *, unsigned int))dlsym(RTLD_NEXT, "memfd_create");
+  }
+  int fd = realMemfd != NULL ? realMemfd(name, flags)
+                             : (int)syscall(SYS_memfd_create, name, flags);
+  if (fd != -1) {
+    processOpenFd(fd, NULL, O_RDWR, 0);
+  }
+  return fd;
+}
