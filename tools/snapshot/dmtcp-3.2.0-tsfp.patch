+++ b/src/plugin/ipc/file/fileconnlist.cpp
@@ -484,6 +484,28 @@ FileConnList::recreateShmFileAndMap(const ProcMapsArea &area)
   // Recreate file in dmtcp-tmpdir;
   string filename = removeSuffix(area.name, DELETED_FILE_SUFFIX);
 
+  if (strncmp(area.name, "/memfd:", 7) == 0) {
+    // T1153: an anonymous memfd mapping (Mesa lavapipe/llvmpipe sub-allocate one memfd into hundreds of
+    // mappings). FileConnection::postRestart recreated the memfd with its full saved content on the original
+    // fd number, so map THAT object at the area's file offset: every mapping keeps sharing one file.
+    for (iterator it = begin(); it != end(); ++it) {
+      Connection *con = it->second;
+      if (con->conType() != Connection::FILE) {
+        continue;
+      }
+      FileConnection *fileCon = (FileConnection *)con;
+      if (fileCon->inode() == area.inodenum &&
+          strncmp(fileCon->filePath().c_str(), "/memfd:", 7) == 0 && con->numFds() > 0) {
+        int mapFd = con->getFds()[0];
+        // not restoreShmArea: it closes the fd, which stays the process's own memfd here
+        void *addr = mmap(area.addr, area.size, area.prot, MAP_FIXED | area.flags, mapFd, area.offset);
+        JASSERT(addr != MAP_FAILED) (area.flags) (area.prot) (mapFd) (JASSERT_ERRNO).Text("memfd mmap failed");
+        return;
+      }
+    }
+    JASSERT(false) (area.name) (area.inodenum).Text("memfd mapping without a restored memfd connection");
+  }
+
   JASSERT(createDirectoryTree(area.name)) (area.name)
   .Text("Unable to create directory in File Path");
 
